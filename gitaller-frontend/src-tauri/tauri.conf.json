{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "GITaller",
  "version": "0.1.2",
  "identifier": "com.RandomDev.GiTaller",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "GITaller",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "gitaller-server"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5RDgxMTg3RTYzREIyMUMKUldRY3NqM21oeEhZS2JuQlZpZi9RMUdFejZWOTFoa2djdUk0dCsxNHdKNm55ZmNaOHZ6ZGVUd2YK",
      "endpoints": [
        "https://raw.githubusercontent.com/Random-Dev143/taller_gestor_updates/refs/heads/main/update.json"
      ]
    }
  }
}
