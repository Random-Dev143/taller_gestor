{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "GITaller",
  "version": "0.1.1",
  "identifier": "com.RandomDev.GiTaller",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "GITaller",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "gitaller-server"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "PEGAR_AQUI_EL_CONTENIDO_DE_gitaller.key.pub",
      "endpoints": [
        "https://tu-servidor-o-github/releases/latest/download/latest.json"
      ]
    }
  }
}
